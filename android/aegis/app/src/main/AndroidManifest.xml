<?xml version="1.0" encoding="utf-8"?>
<!--
  Aegis Android Companion manifest.

  Only the minimum permissions required for the documented behaviour
  are declared. See android/aegis/README.md for the full rationale.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.guardianmesh.aegis">

    <uses-sdk
        android:minSdkVersion="24"
        android:targetSdkVersion="34" />

    <uses-permission
        android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission
        android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PROJECTION" />
    <uses-permission
        android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:label="@string/app_name"
        android:name=".app.AegisApplication"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="false">

        <service
            android:name=".app.AegisForegroundService"
            android:exported="false"
            android:foregroundServiceType="mediaProjection" />

        <activity
            android:name=".app.AegisConsentActivity"
            android:exported="false"
            android:theme="@style/Theme.Aegis.Consent" />

    </application>
</manifest>
